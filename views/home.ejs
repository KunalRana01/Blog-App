<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blogify</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <%- include('partials/navbar', { active: 'home' , user:user}) %>

        <div class="max-w-7xl mx-auto px-6 py-10">

            <h1 class="text-3xl font-bold mb-8">Latest Blogs</h1>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

                <% blogs.forEach(blog=> { %>

                    <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition">

                        <!-- Cover Image -->
                        <img src="<%= blog.coverImageUrl %>" class="w-full h-48 object-cover">

                        <!-- Content -->
                        <div class="p-5">

                            <h2 class="text-xl font-semibold mb-2">
                                <%= blog.title %>
                            </h2>

                            <p class="text-gray-600 text-sm mb-4">
                                <%= blog.body.substring(0,120) %>...
                            </p>

                            <a href="/blog/<%= blog._id %>" class="text-blue-600 font-medium hover:underline">
                                Read More →
                            </a>

                        </div>

                    </div>

                    <% }) %>

            </div>
        </div>
</body>

</html>